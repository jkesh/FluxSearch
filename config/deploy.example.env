# FluxSearch 本地运行时 / 一键部署参数（模板）
# 复制为 config/local/deploy.env 并按环境修改
# config/local/ 已加入 .gitignore

# ── API / Monitor / 前端 ─────────────────────────────────
FLUXSEARCH_API_ADDR=
FLUXSEARCH_API_PORT=8080
FLUXSEARCH_MONITOR_ADDR=
FLUXSEARCH_MONITOR_PORT=8090
FLUXSEARCH_FRONTEND_PORT=5173
# Vite 开发代理目标（默认 http://127.0.0.1:${FLUXSEARCH_API_PORT}）
FLUXSEARCH_VITE_API_PROXY=

# ── FlagEmbedding 推理服务（BGE-M3 + Reranker）──────────
FLUXSEARCH_FLAGEMBEDDING_ENABLED=true
FLUXSEARCH_FLAGEMBEDDING_HOST=127.0.0.1
FLUXSEARCH_FLAGEMBEDDING_PORT=8091
FLUXSEARCH_FLAGEMBEDDING_MODEL=BAAI/bge-m3
FLUXSEARCH_FLAGEMBEDDING_RERANK_MODEL=BAAI/bge-reranker-v2-m3
# 设备：cuda / cpu / 留空=自动
FLUXSEARCH_FLAGEMBEDDING_DEVICE=cuda
FLUXSEARCH_FLAGEMBEDDING_SPARSE_DEVICE=cpu
FLUXSEARCH_FLAGEMBEDDING_FP16=true
FLUXSEARCH_FLAGEMBEDDING_MAX_LENGTH=512
# true 时不加载 reranker（仅 embedding）
FLUXSEARCH_FLAGEMBEDDING_NO_RERANKER=false

# ── Rerank HTTP 客户端（Go API 调用精排）────────────────
FLUXSEARCH_RERANK_BATCH_SIZE=32
# 留空时由 app.settings.json / EffectiveSearchSettings 决定
FLUXSEARCH_RERANK_API_URL=
FLUXSEARCH_RERANK_MODEL=

# ── 一键部署：启动哪些进程 ───────────────────────────────
FLUXSEARCH_DEPLOY_BUILD=false
FLUXSEARCH_DEPLOY_START_FLAGEMBEDDING=true
FLUXSEARCH_DEPLOY_START_API=true
FLUXSEARCH_DEPLOY_START_FRONTEND=true
FLUXSEARCH_DEPLOY_START_MONITOR=true
FLUXSEARCH_DEPLOY_START_WORKER=false

# ── 日志与 PID 目录（相对项目根）────────────────────────
FLUXSEARCH_DEPLOY_LOG_DIR=.deploy/logs
FLUXSEARCH_DEPLOY_PID_DIR=.deploy/pids
