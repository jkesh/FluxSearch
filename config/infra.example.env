# FluxSearch 基础设施连接信息（模板）
# 复制为 config/local/infra.env 并填入实际值
# config/local/ 目录已加入 .gitignore，不会提交到 Git

# ── 服务器 / SSH ──────────────────────────────────────────
FLUXSEARCH_SERVER_HOST=your-k8s-node.example.com
FLUXSEARCH_SERVER_USER=deploy
FLUXSEARCH_SSH_PORT=22
FLUXSEARCH_K8S_NAMESPACE=fluxsearch
FLUXSEARCH_KUBECONFIG_REMOTE=/home/deploy/.kube/config

# ── 本地代理（v2rayN，用于远程拉取镜像/Chart）──────────────
FLUXSEARCH_PROXY_SOCKS5=127.0.0.1:10808
FLUXSEARCH_PROXY_HTTP=
FLUXSEARCH_PROXY_TUNNEL_REMOTE_PORT=11080

# ── PostgreSQL ───────────────────────────────────────────
FLUXSEARCH_POSTGRES_HOST=postgres.fluxsearch.svc.cluster.local
FLUXSEARCH_POSTGRES_PORT=5432
FLUXSEARCH_POSTGRES_USER=fluxsearch
FLUXSEARCH_POSTGRES_PASSWORD=
FLUXSEARCH_POSTGRES_DB=fluxsearch
FLUXSEARCH_DATABASE_URL=postgresql://fluxsearch:PASSWORD@postgres.fluxsearch.svc.cluster.local:5432/fluxsearch

# ── Redis ────────────────────────────────────────────────
FLUXSEARCH_REDIS_HOST=redis.fluxsearch.svc.cluster.local
FLUXSEARCH_REDIS_PORT=6379
FLUXSEARCH_REDIS_PASSWORD=
FLUXSEARCH_REDIS_URL=redis://:PASSWORD@redis.fluxsearch.svc.cluster.local:6379/0

# ── MinIO（对象存储）────────────────────────────────────
FLUXSEARCH_MINIO_ENDPOINT=minio.fluxsearch.svc.cluster.local:9000
FLUXSEARCH_MINIO_ACCESS_KEY=
FLUXSEARCH_MINIO_SECRET_KEY=
FLUXSEARCH_MINIO_BUCKET=milvus-bucket
FLUXSEARCH_MINIO_DOCUMENTS_BUCKET=fluxsearch-documents
FLUXSEARCH_MINIO_USE_SSL=false
FLUXSEARCH_MINIO_CONSOLE_PORT=9001

# ── Milvus（向量数据库）──────────────────────────────────
FLUXSEARCH_MILVUS_HOST=milvus.fluxsearch.svc.cluster.local
FLUXSEARCH_MILVUS_PORT=19530
FLUXSEARCH_MILVUS_URI=http://milvus.fluxsearch.svc.cluster.local:19530

# ── Embedding（二选一：百炼 / 本地 Ollama·llama.cpp）────────────────
# provider: bailian | local | ollama | llamacpp | 留空=仅分块不向量化
#
# 【方案 A】阿里云百炼（OpenAI 兼容）
# FLUXSEARCH_EMBEDDING_PROVIDER=bailian
# FLUXSEARCH_EMBEDDING_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# FLUXSEARCH_EMBEDDING_API_KEY=sk-xxx
# FLUXSEARCH_EMBEDDING_MODEL=text-embedding-v3
# FLUXSEARCH_EMBEDDING_DIM=1024
#
# 【方案 B】本地 Ollama（llama.cpp，推荐 bge-m3）
# FLUXSEARCH_EMBEDDING_PROVIDER=local
# FLUXSEARCH_EMBEDDING_LOCAL_BACKEND=ollama
# FLUXSEARCH_EMBEDDING_API_URL=http://127.0.0.1:11434
# FLUXSEARCH_EMBEDDING_MODEL=bge-m3
# FLUXSEARCH_EMBEDDING_DIM=1024
#
# 【方案 B2】本地 llama-server --embedding（OpenAI 兼容）
# FLUXSEARCH_EMBEDDING_PROVIDER=local
# FLUXSEARCH_EMBEDDING_LOCAL_BACKEND=llamacpp
# FLUXSEARCH_EMBEDDING_API_URL=http://127.0.0.1:8081/v1
# FLUXSEARCH_EMBEDDING_MODEL=bge-m3
# FLUXSEARCH_EMBEDDING_DIM=1024

FLUXSEARCH_EMBEDDING_PROVIDER=
FLUXSEARCH_EMBEDDING_LOCAL_BACKEND=ollama
FLUXSEARCH_EMBEDDING_API_URL=
FLUXSEARCH_EMBEDDING_API_KEY=
FLUXSEARCH_EMBEDDING_MODEL=
FLUXSEARCH_EMBEDDING_DIM=1024
FLUXSEARCH_EMBEDDING_BATCH_SIZE=16

# ── LLM 对话（百炼 / 本地，也可在设置页配置）──────────────
# FLUXSEARCH_LLM_PROVIDER=bailian
# FLUXSEARCH_LLM_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# FLUXSEARCH_LLM_API_KEY=sk-xxx
# FLUXSEARCH_LLM_MODEL=qwen-plus
# FLUXSEARCH_LLM_TEMPERATURE=0.7
# FLUXSEARCH_LLM_MAX_TOKENS=2048

# ── Milvus 向量检索（可在设置页调整）──────────────────────
# FLUXSEARCH_MILVUS_INDEX_TYPE=ivf_flat
# FLUXSEARCH_MILVUS_METRIC=IP
# FLUXSEARCH_MILVUS_NLIST=128
# FLUXSEARCH_MILVUS_NPROBE=16
# FLUXSEARCH_MILVUS_HNSW_M=16
# FLUXSEARCH_MILVUS_HNSW_EF_CONSTRUCTION=200
# FLUXSEARCH_MILVUS_HNSW_EF=64
# FLUXSEARCH_SEARCH_SCORE_THRESHOLD=0

# ── 检索 / 监控 ───────────────────────────────────────────
FLUXSEARCH_SEARCH_TOP_K=5
# FLUXSEARCH_MONITOR_URL=http://your-k8s-node.example.com:8090/api/v1/status

# 运行时配置也可通过 UI 保存到 config/local/app.settings.json

# ── Chunker（递归分割）──────────────────────────────────
FLUXSEARCH_CHUNK_MAX_TOKENS=512
FLUXSEARCH_CHUNK_OVERLAP_TOKENS=64

# API 进程是否消费导入/重索引队列（生产可设为 false，由 fluxsearch-worker 处理）
FLUXSEARCH_IMPORT_WORKER_IN_API=true

# ── etcd（Milvus 元数据）─────────────────────────────────
FLUXSEARCH_ETCD_HOST=etcd.fluxsearch.svc.cluster.local
FLUXSEARCH_ETCD_PORT=2379
FLUXSEARCH_ETCD_ENDPOINTS=etcd.fluxsearch.svc.cluster.local:2379

# ── K8s Secret 名称（集群内引用）──────────────────────────
FLUXSEARCH_K8S_SECRET_NAME=fluxsearch-infra

# ── 集群外访问（port-forward 示例）────────────────────────
# kubectl port-forward -n fluxsearch svc/postgres 5432:5432
# kubectl port-forward -n fluxsearch svc/milvus 19530:19530
# kubectl port-forward -n fluxsearch svc/minio 9000:9000
FLUXSEARCH_POSTGRES_HOST_LOCAL=127.0.0.1
FLUXSEARCH_POSTGRES_PORT_LOCAL=5432
FLUXSEARCH_MILVUS_HOST_LOCAL=127.0.0.1
FLUXSEARCH_MILVUS_PORT_LOCAL=19530
FLUXSEARCH_MINIO_ENDPOINT_LOCAL=127.0.0.1:9000
